<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="rootPane" prefHeight="800.0" prefWidth="1400.0"
            style="-fx-background-color: #f5f7fa;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.controllers.HoTroControllerNV"
            stylesheets="@../CSS/hotronv.css">

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="20" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">

                    <!-- HEADER -->
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-padding: 20;">
                        <Label text="Hướng Dẫn Sử Dụng Hệ Thống Cho Nhân Viên"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label text="Tài liệu hướng dẫn chi tiết các tính năng của hệ thống quản lý nhà hàng Crabking"
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                    </VBox>

                    <!-- SEARCH BOX -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
                        <TextField fx:id="txtTimKiem" promptText="Tìm kiếm hướng dẫn..."
                                   style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 10 20; -fx-font-size: 14px; -fx-pref-width: 500;"
                                   styleClass="search-box" />
                        <Button text="Tìm kiếm"
                                style="-fx-background-color: #E6763E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20;"
                                onAction="#onTimKiemClick" />
                    </HBox>

                    <!-- QUICK ACCESS CARDS -->
                    <VBox spacing="15">
                        <Label text="Truy Cập Nhanh"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                        <GridPane fx:id="helpCardsContainer"
                                  hgap="15" vgap="15"
                                  style="-fx-padding: 10;"
                                  maxWidth="Infinity">

                            <!-- Đặt 3 cột cố định -->
                            <columnConstraints>
                                <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="33.33"/>
                                <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="33.33"/>
                                <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="33.33"/>
                            </columnConstraints>

                        </GridPane>

                    </VBox>

                    <!-- FAQ SECTION -->
                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-padding: 20;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Các Câu Hỏi Thường Gặp (FAQ)"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <HBox spacing="5" style="-fx-padding: 0 0 0 20;">
                                <Button text="Mở tất cả"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 5 15;"
                                        onAction="#onExpandAllFAQ" />
                                <Button text="Thu gọn"
                                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 5 15;"
                                        onAction="#onCollapseAllFAQ" />
                            </HBox>
                        </HBox>

                        <VBox fx:id="faqContainer" spacing="10" style="-fx-padding: 10 0;">
                        </VBox>
                    </VBox>

                    <!-- CONTACT SECTION -->
                    <HBox spacing="10" style="-fx-background-color: #e86535; -fx-background-radius: 15; -fx-padding: 25;"
                          alignment="CENTER_LEFT">
                        <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="350">
                            <Label text="Liên Hệ Hỗ Trợ"
                                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                            <Label text="Hotline: 1900 1234"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="Email: support@restaurant.com"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="Giờ làm việc: 8:00 - 22:00 hàng ngày"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                        </VBox>

                        <Separator orientation="VERTICAL" style="-fx-background-color: #4a6572;" />

                        <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="350">
                            <Label text="Hướng Dẫn Làm Việc"
                                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

                            <Label text="• Kiểm tra ca làm việc trước khi bắt đầu"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Nhập đơn hàng chính xác trước khi xác nhận"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Báo quản lý ngay khi phát sinh lỗi hệ thống"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Không tự ý sửa hoặc xoá dữ liệu"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Thực hiện kết ca sau khi kết thúc ca làm"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />

                        </VBox>

                        <Separator orientation="VERTICAL" style="-fx-background-color: #4a6572;" />

                        <VBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Thành viên phát triển"
                                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                            <Label text="• Trần Lê Khoa"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Trần Quốc Nhã"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Đỗ Minh Quân"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                            <Label text="• Nguyễn Hà Nhật Khanh"
                                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" />
                        </VBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>