<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="root"
            prefHeight="800.0" prefWidth="1400.0"
            stylesheets="@../CSS/bangiaoca.css, @../CSS/AppMD.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.controllers.BanGiaoCaController">

    <!-- ================== TRUNG TÂM ================== -->
    <center>
        <AnchorPane fx:id="center_Panel" styleClass="center-content"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <!-- KHU VỰC DANH SÁCH HÓA ĐƠN -->
            <VBox spacing="10"
                  style="-fx-background-color: #EFEFEF; -fx-background-radius: 20 20 28 28;"
                  AnchorPane.topAnchor="20.0"
                  AnchorPane.leftAnchor="20.0"
                  AnchorPane.rightAnchor="20.0"
                  AnchorPane.bottomAnchor="230.0"
                  VBox.vgrow="ALWAYS">

                <!-- Thanh tìm kiếm -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="menu-search-box">
                    <Label text="🔍" fx:id="searchIcon" styleClass="search-icon" />
                    <TextField fx:id="searchField" promptText="Tìm kiếm: bàn, số điện thoại, tên khách"
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Danh sách hóa đơn -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            styleClass="scroll_order"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="vboxHoaDon" spacing="10">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>


                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="invoice-card">
                                <!-- BÊN TRÁI -->
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Circle radius="20" style="-fx-fill: #d8d8d8;" />
                                    <VBox spacing="2">
                                        <Label styleClass="invoice-id" text="HD000002"/>
                                        <Label styleClass="invoice-phone" text="SDT: 0912345678"/>
                                        <Label styleClass="invoice-name" text="Tên: Nguyễn Văn A"/>
                                    </VBox>
                                </HBox>

                                <!-- ĐẨY NỘI DUNG BÊN PHẢI -->
                                <Pane HBox.hgrow="ALWAYS" />

                                <!-- BÊN PHẢI: Tổng tiền -->
                                <Label styleClass="invoice-total" text="125.000đ" />
                            </HBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- Ô tổng kết doanh thu -->
            <AnchorPane prefHeight="180.0"
                        AnchorPane.bottomAnchor="20.0"
                        AnchorPane.leftAnchor="20.0"
                        AnchorPane.rightAnchor="20.0"
                        styleClass="anchorPane_LabelBaoCao"
                        xmlns="http://javafx.com/javafx"
                        xmlns:fx="http://javafx.com/fxml">

                <children>

                    <!-- TITLE FULL WIDTH -->
                    <HBox styleClass="summary-title-bar"
                          AnchorPane.topAnchor="0.0"
                          AnchorPane.leftAnchor="0.0"
                          AnchorPane.rightAnchor="0.0"
                          prefHeight="40">
                        <children>
                            <Label text="Tổng kết ca" styleClass="summary-title"/>
                        </children>
                    </HBox>

                    <!-- GRIDPANE NỘI DUNG -->
                    <GridPane alignment="CENTER" hgap="40" vgap="20"
                              AnchorPane.topAnchor="50.0"
                              AnchorPane.bottomAnchor="10.0"
                              AnchorPane.leftAnchor="10.0"
                              AnchorPane.rightAnchor="10.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>

                        <children>
                            <Label fx:id="lblTienMat" styleClass="summary-label"
                                   text="Tiền mặt: 1.230.000 VND"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                            <Label fx:id="lblCKhoan" styleClass="summary-label"
                                   text="Chuyển khoản: 20.000 VND"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                            <Label fx:id="lblsoHD" styleClass="summary-label"
                                   text="Số hóa đơn: 36"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label fx:id="lblDThu" styleClass="summary-label"
                                   text="Doanh thu: 1.250.000 VND"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </children>
                    </GridPane>

                </children>
            </AnchorPane>


        </AnchorPane>
    </center>

    <!-- ================== BÊN PHẢI ================== -->
    <right>
        <VBox fx:id="rightSidebar"
              BorderPane.alignment="CENTER"
              VBox.vgrow="ALWAYS"
              styleClass="right">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Tiêu đề -->
            <VBox alignment="CENTER" prefHeight="55" styleClass="header-section">
                <Label minHeight="40.0" minWidth="350.0" styleClass="section-title" text="Báo Cáo Kết Ca" />
            </VBox>

            <!-- Form nội dung -->
            <VBox spacing="10" styleClass="form-section" VBox.vgrow="ALWAYS">
                <Label styleClass="label_form-section" text="Ca làm"/>
                <TextField fx:id="txtCaLam" editable="false" promptText="Ca làm" style="-fx-opacity: 1;"/>

                <Label styleClass="label_form-section" text="Thời gian vào ca"/>
                <TextField fx:id="txtTGVC" editable="false" promptText="..." style="-fx-opacity: 1;"/>

                <Label styleClass="label_form-section" text="Số hóa đơn"/>
                <TextField fx:id="txtsLHD" editable="false"/>

                <Label styleClass="label_form-section" text="Số tiền mặt"/>
                <TextField fx:id="txtSoTienMat"/>

                <Label styleClass="label_form-section" text="Số tiền chuyển khoản"/>
                <TextField fx:id="txtSoTienCK"/>

                <Label styleClass="label_form-section" text="Tổng tiền trong ca"/>
                <TextField fx:id="txtTongTien"/>

                <Label styleClass="label_form-section" text="Ghi chú"/>
                <TextArea fx:id="taMoTa" prefRowCount="4"/>
            </VBox>

            <!-- Nút kết ca -->
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="btnKetCa" text="Kết Ca"
                        prefHeight="45" prefWidth="165"
                        styleClass="end-shift-btn"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
