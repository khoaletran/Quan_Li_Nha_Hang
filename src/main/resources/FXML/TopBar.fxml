<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox fx:id="root" alignment="CENTER_LEFT" maxHeight="32.0" minHeight="32.0" prefHeight="32.0" spacing="12" styleClass="top-bar" stylesheets="@../CSS/topbar.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.TopBarController">

    <children>

        <!-- LEFT: logo + tên + chức vụ -->
        <HBox alignment="CENTER_LEFT" spacing="6">
            <children>
                <ImageView fx:id="imgLogo" fitHeight="20" fitWidth="20" styleClass="top-logo">
                    <image>
                        <Image url="@../IMG/logo_1.png" />
                    </image>
                </ImageView>
            <Text strokeType="OUTSIDE" styleClass="top-username" strokeWidth="0.0" text="CrabKing Restaurant" />

<!--                <VBox spacing="0">-->
<!--                    <children>-->
<!--                        <Label fx:id="lblUserName" styleClass="top-username" />-->
<!--                        <Label fx:id="lblUserRole" styleClass="top-role" />-->
<!--                    </children>-->
<!--                </VBox>-->
            </children>
        </HBox>

        <!-- Spacer trái để đẩy clock ra giữa -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- CENTER: clock -->
        <Label fx:id="lblClock" styleClass="top-clock" />

        <!-- Spacer phải để clock nằm giữa, nút dạt về cuối -->
        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnMinimize" minHeight="20.0" minWidth="28.0" styleClass="win-btn" text="─" />

        <Button fx:id="btnMaximize" minHeight="20.0" minWidth="28.0" styleClass="win-btn" text="▢" />

        <!-- RIGHT: action button + window buttons -->
        <Button fx:id="btnAction" minHeight="24.0" minWidth="70.0" styleClass="top-action-btn" text="Kết Ca" />

    </children>

    <padding>
        <Insets left="10.0" right="10.0" />
    </padding>
</HBox>
